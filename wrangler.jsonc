// Cloudflare Workers config for the Next.js app via @opennextjs/cloudflare.
// Generate typed bindings with: pnpm cf:typegen
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docker-jenkins-camp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "docker-jenkins-camp"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docker-jenkins-camp-db",
      "database_id": "9db7dd70-1cc2-4d4c-a784-9f21d0a41ac2"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://docker-jenkins-camp.workers.dev"
  }
}
